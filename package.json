{
  "name": "nxip-cli",
  "version": "0.3.0",
  "description": "Scan your AWS estate for overlapping VPC CIDRs and wasted address space, and manage IP allocation with plan/apply - no Terraform required",
  "keywords": [
    "ipam",
    "ip-address-management",
    "cidr",
    "subnet",
    "vpc",
    "aws",
    "terraform",
    "networking",
    "ip-allocation",
    "network-automation"
  ],
  "homepage": "https://nx-ip.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/uk-sw/nxip-cli"
  },
  "bugs": {
    "url": "https://github.com/uk-sw/nxip-cli/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "nxip": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1125.0",
    "@aws-sdk/client-sts": "^3.1125.0",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
